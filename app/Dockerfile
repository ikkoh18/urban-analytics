FROM nginx:alpine

COPY build/web /usr/share/nginx/html

# Flutter web usa roteamento client-side — redireciona 404 para index.html
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
